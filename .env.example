# Auth mode: 'mock' (default, no external services needed) or 'live' (requires LIFF + Supabase below)
NUXT_PUBLIC_AUTH_MODE=mock

# LINE LIFF (only required when NUXT_PUBLIC_AUTH_MODE=live)
NUXT_PUBLIC_LIFF_ID=

# Supabase (only required when NUXT_PUBLIC_AUTH_MODE=live)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
